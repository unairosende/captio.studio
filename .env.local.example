# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.
# In production these live in Vercel → Settings → Environment Variables.

# ── Database ───────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# Use the POOLER string (port 6543), not the direct one: serverless functions
# open far more connections than a Postgres instance will accept.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-north-1.pooler.supabase.com:6543/postgres

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate the secret with:  openssl rand -base64 32
# Rotating it signs every user out, so treat it like a password.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com → APIs & Services → Credentials
# Must be a Google Cloud project owned by the business that invoices customers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email ──────────────────────────────────────────────────────────────────
# Organisation invitations are useless without a sender.
RESEND_API_KEY=
EMAIL_FROM=captio <no-reply@send.captio.studio>

# ── Storage ────────────────────────────────────────────────────────────────
# Media goes to object storage, never into Postgres. R2 has no egress charge,
# which is where a media-heavy product actually bleeds money.
# The 32-character account id. The full S3 endpoint URL Cloudflare shows next to
# the credentials is accepted too — the id is read out of it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Set to `eu` when the bucket was created under the EU jurisdiction. Not
# cosmetic: a jurisdictional bucket answers only on its own endpoint
# (<account>.eu.r2.cloudflarestorage.com) and does not exist as far as the plain
# one is concerned. Leave empty for a bucket created without a jurisdiction.
R2_JURISDICTION=eu

# Guards /api/cron/sweep-media, which deletes objects. Vercel sends it as a
# bearer token on scheduled runs. Unset, the sweeper refuses to run at all —
# the right way round for something whose job is deleting.
CRON_SECRET=

# ── Billing ────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_INDIVIDUAL=price_...
STRIPE_PRICE_TEAM=price_...

# ── AI providers ───────────────────────────────────────────────────────────
# Server-side only. These must never reach the browser.

# Transcription. ElevenLabs Scribe, because it returns per-word timings and
# marks who is speaking — cue boundaries are then decided by subtitling rules
# rather than accepted from a recogniser that was optimising for a transcript.
ELEVENLABS_API_KEY=

GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-...
MISTRAL_API_KEY=
OPENAI_API_KEY=sk-...

# Per-model prices, used to turn usage into cost. Without it, cost is recorded
# as zero rather than guessed.
PRICES={"gemini-2.5-flash":{"inPerMTok":0.30,"outPerMTok":2.50},"scribe_v1":{"perHour":0.22}}

# ── App ────────────────────────────────────────────────────────────────────
# Used for invitation links and OAuth callbacks. Must be the real public URL in
# production: a localhost value here breaks sign-in for everyone.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The supabase-js variables are gone. Supabase is still the database, but it is
# reached through DATABASE_URL like any other Postgres — nothing in the app
# knows which provider is behind it.
